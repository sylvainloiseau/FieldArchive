    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en" datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">The Person Name Vocabulary (PNV) is an rdf vocabulary and data model for persons&apos; names. It is applicable to many datasets in which persons are described, as it accommodates different levels of data granularity.</Literal>
    </Annotation>
